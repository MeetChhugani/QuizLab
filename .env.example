# ─────────────────────────────────────────────────────────────────────────────
# QuizLab AI — Environment Variables Example
# Copy this file to .env and fill in your values.
# NEVER commit the real .env file — it is already in .gitignore.
# ─────────────────────────────────────────────────────────────────────────────

# Hugging Face Token (required for LLM inference)
# Get your free Access Token at: https://huggingface.co/settings/tokens
HF_TOKEN=your_huggingface_token_here

# Optional: override the default Hugging Face model
# HF_MODEL=meta-llama/Llama-3.3-70B-Instruct

# ── RAG Tuning (optional, defaults shown) ────────────────────────────────────
# RAG_TOP_K=5
# RAG_CHUNK_SIZE=800
# RAG_CHUNK_OVERLAP=100
# RAG_MIN_CHUNK_SIZE=80
# RAG_MAX_CONTEXT_CHARS=6000
# RAG_MAX_CONVERSATION_TURNS=6
# RAG_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# RAG_CHROMA_COLLECTION=quizlab_documents
